{
  "name": "cymento-financeapp",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@prisma/client": "^6.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katanakit-js": "^6.8.4",
    "nuxt": "^4.6.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prisma": "^6.11.1",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  }
}
